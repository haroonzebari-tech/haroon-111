<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:background="#070A0E" android:padding="10dp"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="60dp">
        <ImageView android:src="@drawable/ic_haron_tv" android:contentDescription="Haron TV"
            android:layout_width="48dp" android:layout_height="48dp" />
        <LinearLayout android:orientation="vertical" android:paddingStart="10dp"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
            <TextView android:text="HARON TV" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:text="بث مباشر للقنوات التلفزيونية" android:textColor="#8E9AA8" android:textSize="12sp"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
        android:background="#121922" android:paddingStart="12dp" android:paddingEnd="8dp"
        android:layout_width="match_parent" android:layout_height="50dp">
        <TextView android:text="⌕" android:textColor="#42A5F5" android:textSize="26sp"
            android:layout_width="34dp" android:layout_height="wrap_content" android:gravity="center" />
        <EditText android:id="@+id/search" android:hint="ابحث عن قناة..." android:hintTextColor="#687585"
            android:textColor="#FFFFFF" android:textSize="15sp" android:singleLine="true"
            android:background="@android:color/transparent" android:padding="0dp"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" />
    </LinearLayout>

    <Spinner android:id="@+id/groupSpinner" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="7dp" />
    <TextView android:id="@+id/status" android:text="جاري تحميل القنوات..." android:textColor="#AAB4C0"
        android:textSize="13sp" android:paddingTop="6dp" android:paddingBottom="6dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />

    <androidx.media3.ui.PlayerView android:id="@+id/player" android:layout_width="match_parent"
        android:layout_height="215dp" android:background="#000000" />

    <ListView android:id="@+id/channelList" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:divider="#1E2732" android:dividerHeight="1dp"
        android:clipToPadding="false" android:paddingTop="6dp" android:paddingBottom="6dp" />

    <LinearLayout android:orientation="horizontal" android:gravity="center" android:layout_width="match_parent" android:layout_height="52dp">
        <Button android:id="@+id/favorites" android:text="★ المفضلة" android:textAllCaps="false"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" />
        <Button android:id="@+id/refresh" android:text="↻ تحديث" android:textAllCaps="false"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" />
        <Button android:id="@+id/fullscreen" android:text="⛶ ملء الشاشة" android:textAllCaps="false"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" />
    </LinearLayout>
</LinearLayout>
