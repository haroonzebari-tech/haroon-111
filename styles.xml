<resources>
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#070A0E</item>
        <item name="android:navigationBarColor">#070A0E</item>
        <item name="android:colorAccent">#42A5F5</item>
    </style>
    <style name="AppTheme.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#070A0E</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_haron_tv</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
